    def edges(self, /, key: tuple[tuple[SupportsIndex, SupportsIndex], tuple[SupportsIndex, SupportsIndex]]) -> list[tuple[int, list[tuple[tuple[int, int], tuple[int, int]]], int, Any, int |None, int]]: ...

@final
class ChartProgram:
    """
    The native rule-drawing program shared by both chart retention modes.
    """
    def __new__(cls, /, rules: SupportsGetItem[int, tuple[SupportsIndex, SupportsIndex, bool, SupportsGetItem[int, tuple[SupportsGetItem[int, SupportsIndex], str, SupportsIndex]]]], tags: SupportsIndex, rule_program: RuleProgram, *, normalizes: bool, category_measure: SupportsGetItem[int, tuple[str, SupportsIndex]] = ..., category_bounds: tuple[SupportsIndex |None, SupportsIndex |None] = ...) -> ChartProgram: ...
    def __repr__(self, /) -> str: ...
    def cached_outputs(self, /, rule: SupportsIndex, inputs: SupportsGetItem[int, SupportsIndex]) -> list[int] |None:
        """
        Return memoized normalized outputs for one complete rule application.
        """
    def closure(self, /, arrival: SupportsGetItem[int, tuple[SupportsIndex, SupportsIndex]], span: tuple[SupportsIndex, SupportsIndex], depth: SupportsIndex, resolver: Any) -> tuple[list[tuple[tuple[int, int], int, tuple[int, int]]], list[tuple[int, int]], bool]:
        """
        Close unary rules over one cell up to the supplied depth.
        """
    def configure_reachability(self, /, owner: Term, representatives: RepresentativeKernel, plan: tuple[SupportsIndex, SupportsIndex, SupportsIndex], roots: Any, lexical: Any, rules: Any) -> None:
        """
        Install the exact per-span category demands for one root-directed parse.
        
        `plan` is the sentence length in tokens, the unary closure depth per
        cell, and the most binding-and-candidate pairs one lexical refinement
        enumerates.
        """
    def identify(self, /, term: Term) -> int |None:
        """
        Return the dense identifier owned by one exact native category.
        """
    def lookup(self, /, term: Term) -> int |None:
        """
        Return one registered category's dense identifier when present.
        """
    def pairs(self, /, left: SupportsGetItem[int, SupportsIndex], right: SupportsGetItem[int, SupportsIndex]) -> list[tuple[int, int, list[int]]]:
        """
        Enumerate indexed binary pairs in Cartesian order.
        """
    def reachable(self, /, span: tuple[SupportsIndex, SupportsIndex], category: SupportsIndex) -> bool:
        """
        Return whether one registered category remains root-reachable at a span.
        """
    @property
    def refused_categories(self, /) -> int:
        """
        Return how many distinct exact categories the declared bounds refused.
        """
    def remember_outputs(self, /, rule: SupportsIndex, inputs: SupportsGetItem[int, SupportsIndex], outputs: SupportsGetItem[int, SupportsIndex]) -> None:
        """
        Memoize normalized outputs for one complete rule application.
        """
    def rules_of_arity(self, /, arity: SupportsIndex) -> list[int]:
        """
        Return candidate rule identifiers of one arity.
        """
    def steps(self, /, inputs: SupportsGetItem[int, SupportsIndex], tags: SupportsGetItem[int, SupportsIndex], span: tuple[SupportsIndex, SupportsIndex], candidates: SupportsGetItem[int, SupportsIndex], resolver: Any) -> list[tuple[int, int, int]]:
        """
        Draw one exact premise tuple, resolving a cache miss in Python.
        """
    def term(self, /, identifier: SupportsIndex) -> Term:
        """
        Return the exact category at one dense identifier.
        """

